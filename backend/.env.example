NODE_ENV=development
PORT=5000
PGHOST=localhost
PGPORT=5432
PGDATABASE=dab_automotive
PGUSER=postgres
PGPASSWORD=
# npm run setup:local generates any missing secrets locally.
JWT_SECRET=
OTP_SECRET=
SETTINGS_ENCRYPTION_KEY=
MAIL_MODE=test
# For real delivery, set MAIL_MODE=smtp and fill these values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# New databases only: fill these, run npm run seed:owner, then remove them.
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PHONE=
BOOTSTRAP_OWNER_PASSWORD=
